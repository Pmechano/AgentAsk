<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="936" Height="650" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="True"
        FontFamily="Segoe UI, Microsoft YaHei UI" Foreground="#171D24"
        UseLayoutRounding="True" WindowStartupLocation="Manual">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <PathGeometry x:Key="Hexagon">M 160,24 L 776,24 Q 786,24 790,35 L 914,312 Q 920,325 914,338 L 790,615 Q 786,626 776,626 L 160,626 Q 150,626 146,615 L 22,338 Q 16,325 22,312 L 146,35 Q 150,24 160,24 Z</PathGeometry>
        </ResourceDictionary>
    </Window.Resources>
    <Viewbox Stretch="Uniform">
        <Canvas Width="936" Height="650">
            <Path Data="{StaticResource Hexagon}" Stroke="#171D24" StrokeThickness="2.4">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.8,1">
                        <GradientStop Color="#FFFFFF" Offset="0"/>
                        <GradientStop Color="#F1F4F7" Offset="1"/>
                    </LinearGradientBrush>
                </Path.Fill>
                <Path.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="5" Opacity="0.18" Color="#182D40"/>
                </Path.Effect>
            </Path>
            <!-- One short moving accent rides on the permanent black outline. -->
            <Path x:Name="EdgeLight" Data="{StaticResource Hexagon}" Stroke="#65E3C3"
                  StrokeThickness="3" StrokeDashArray="22 798" StrokeDashCap="Round"
                  IsHitTestVisible="False">
                <Path.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#65E3C3" Opacity="0.65"/>
                </Path.Effect>
            </Path>

            <Grid x:Name="DragHandle" Canvas.Left="164" Canvas.Top="65" Width="608" Height="42"
                  Background="Transparent" Cursor="SizeAll" ToolTip="拖动这里移动窗口">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M 8,0 L 22,0 L 30,13 L 22,26 L 8,26 L 0,13 Z" Fill="#171D24" Width="30" Height="26"/>
                    <TextBlock Text="A G E N T A S K" FontWeight="SemiBold" FontSize="11" Margin="13,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Border Background="#EAF1F0" CornerRadius="12" Padding="11,5" HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="285">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="#239B7D" Margin="0,0,7,0"/>
                        <TextBlock x:Name="AgentName" FontSize="11" Foreground="#45615B" MaxWidth="235" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Canvas.Left="164" Canvas.Top="134" Width="608" Height="392">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="132"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="168"/>
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="问题" FontSize="12" Foreground="#747E8B"/>
                    <TextBlock Text="QUESTION" FontSize="10" Foreground="#A0A9B3" HorizontalAlignment="Right"/>
                </Grid>
                <TextBox x:Name="Question" Grid.Row="1" IsReadOnly="True" IsTabStop="False"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                         Background="Transparent" BorderThickness="0" Padding="0,0,8,0"
                         FontSize="20" FontWeight="Medium" Foreground="#202831" SelectionBrush="#9CECD7">
                    <TextBox.Template>
                        <ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost"/></ControlTemplate>
                    </TextBox.Template>
                </TextBox>
                <Border Grid.Row="2" Height="1" Background="#E0E5EB" VerticalAlignment="Center"/>
                <Grid Grid.Row="3">
                    <TextBlock Text="你的回答" FontSize="12" Foreground="#747E8B"/>
                    <TextBlock Text="YOUR ANSWER" FontSize="10" Foreground="#A0A9B3" HorizontalAlignment="Right"/>
                </Grid>
                <Grid Grid.Row="4">
                    <TextBox x:Name="Answer" Style="{StaticResource AnswerBox}" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="你的回答" TabIndex="0"/>
                    <TextBlock x:Name="Placeholder" Text="写下你的想法…" Foreground="#9AA5AF" FontSize="15"
                               Margin="19,16,0,0" VerticalAlignment="Top" IsHitTestVisible="False"/>
                </Grid>
            </Grid>

            <Button x:Name="Settings" Canvas.Left="76" Canvas.Top="304" Style="{StaticResource IconButton}"
                    ToolTip="外观设置" AutomationProperties.Name="外观设置" TabIndex="3">
                <Path Data="M 10,1 L 12,1 L 12.8,4 L 15,5.3 L 18,4.5 L 19,6.5 L 16.8,8.7 L 16.8,11.3 L 19,13.5 L 18,15.5 L 15,14.7 L 12.8,16 L 12,19 L 10,19 L 9.2,16 L 7,14.7 L 4,15.5 L 3,13.5 L 5.2,11.3 L 5.2,8.7 L 3,6.5 L 4,4.5 L 7,5.3 L 9.2,4 Z M 14,10 A 3,3 0 1 1 8,10 A 3,3 0 1 1 14,10"
                      Stroke="#56616D" StrokeThickness="1.4" Width="20" Height="20" Stretch="Uniform"/>
            </Button>
            <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=Settings}" Placement="Right"
                   HorizontalOffset="10" AllowsTransparency="True" StaysOpen="False">
                <Border Background="#FFFFFF" BorderBrush="#D6DCE3" BorderThickness="1" CornerRadius="14" Padding="18" Margin="10">
                    <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.15"/></Border.Effect>
                    <StackPanel Width="180">
                        <TextBlock Text="外观" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,16"/>
                        <CheckBox x:Name="MotionToggle" Content="边框流光" FontSize="13" IsChecked="True"/>
                        <TextBlock Text="仅作用于当前窗口" Foreground="#88939F" FontSize="11" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </Popup>

            <Grid Canvas.Left="164" Canvas.Top="551" Width="608" Height="46">
                <Button x:Name="Cancel" Content="取消" Style="{StaticResource ButtonBase}" Width="110"
                        HorizontalAlignment="Left" TabIndex="2" ToolTip="取消本次提问 · Esc"/>
                <TextBlock Text="Enter 换行 · Ctrl+Enter 提交" Foreground="#88939F" FontSize="11"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Button x:Name="Submit" Style="{StaticResource PrimaryButton}" Width="136"
                        HorizontalAlignment="Right" TabIndex="1" AutomationProperties.Name="提交">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="提交"/>
                        <Path Data="M 0,5 L 12,5 M 7,0 L 12,5 L 7,10" Stroke="#69E5C4" StrokeThickness="1.7"
                              Width="13" Height="11" Margin="14,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Canvas>
    </Viewbox>
</Window>
